
name: Build Synex Injector APK

on:
  workflow_dispatch:
  push:
    paths:
      - "SynexInjectorAndroid_Source.zip"
      - ".github/workflows/build.yml"

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Install Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.9"

      - name: Extract source
        run: |
          unzip SynexInjectorAndroid_Source.zip
          test -f SynexInjectorAndroid/app/build.gradle.kts

      - name: Build debug APK
        working-directory: SynexInjectorAndroid
        run: gradle assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Synex-Injector-APK
          path: SynexInjectorAndroid/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 7
